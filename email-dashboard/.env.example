# Copy this file to `.env.local` and fill in your Azure app registration's
# Application (client) ID. See README.md for the 5-minute setup walkthrough.

# Required: the Application (client) ID from your Azure app registration.
VITE_AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: the authority (tenant) to sign in against.
#   - "common"        -> work/school AND personal Microsoft accounts (default)
#   - "consumers"     -> personal Microsoft accounts only (outlook.com, hotmail, live)
#   - "organizations" -> work/school accounts only
#   - "<tenant-id>"   -> a single specific tenant
VITE_AAD_AUTHORITY=https://login.microsoftonline.com/common

# Optional: must exactly match a Redirect URI registered on the app
# (type "Single-page application"). Defaults to the current origin.
VITE_REDIRECT_URI=http://localhost:5173
